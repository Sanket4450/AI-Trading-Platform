# Runtime
NODE_ENV=development
TZ=Asia/Kolkata
MARKET_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# Apps
WEB_URL=http://localhost:3000
API_PORT=8000
API_PREFIX=api
TRADING_MODE=offline

DATABASE_URL=postgresql://user:password@host:5432/ai_trading

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=replace-me
JWT_EXPIRES_IN=15m

# Broker — leave blank until R2/R6
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/broker/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX=true

# Risk defaults (R5)
RISK_EQUITY=100000
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=1

# Web -> API (server-side)
API_URL=http://localhost:8000/api/v1

# R1 sessions and secrets
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# 32 random bytes as hex or base64. Required only when storing broker credentials.
CONFIG_ENCRYPTION_KEY=

# R1 seed (required; the seed refuses to run without an operator password)
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=replace-with-a-strong-password
SEED_OPERATOR_NAME="R1 Operator"
SEED_ACCOUNT_CODE=upstox-primary
SEED_ACCOUNT_NAME="Upstox Primary"
SEED_BROKER_USER_REF=
SEED_FORCE_PASSWORD_RESET=false

# R1 worker
UPSTOX_NETWORK_ENABLED=true
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
DATA_BACKFILL_MAX_DAYS=31
WORKER_SCHEDULES_ENABLED=true
INSTRUMENT_SYNC_LIMIT=5000
