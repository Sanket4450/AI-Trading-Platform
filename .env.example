# Runtime
NODE_ENV=development
TZ=Asia/Kolkata
MARKET_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# Apps
WEB_URL=http://localhost:3000
API_PORT=8000
API_PREFIX=api
TRADING_MODE=offline

# PostgreSQL (local Docker)
POSTGRES_USER=ai_trading
POSTGRES_PASSWORD=ai_trading
POSTGRES_DB=ai_trading
DATABASE_URL=postgresql://ai_trading:ai_trading@localhost:5432/ai_trading

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=replace-me
JWT_EXPIRES_IN=15m

# Broker — leave blank until R2/R6
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/broker/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX=true

# Risk defaults (R5)
RISK_EQUITY=100000
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=1
