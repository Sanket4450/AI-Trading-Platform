# Runtime
NODE_ENV=development
TZ=Asia/Kolkata
MARKET_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# Apps
WEB_URL=http://localhost:3000
API_PORT=8000
API_PREFIX=api
TRADING_MODE=research

DATABASE_URL=postgresql://user:password@host:5432/ai_trading

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=replace-me
JWT_EXPIRES_IN=15m

# Broker
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/broker/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX=true
UPSTOX_NETWORK_ENABLED=true
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
UPSTOX_REQUEST_TIMEOUT_MS=60000
UPSTOX_MAX_ATTEMPTS=5
UPSTOX_RATE_LIMIT_PER_SECOND=40
UPSTOX_RATE_LIMIT_PER_MINUTE=400
UPSTOX_RATE_LIMIT_PER_30_MINUTES=1600
UPSTOX_MAX_CONCURRENCY=4

# Backfill and quality
DATA_BACKFILL_MAX_DAYS=31
DATA_BACKFILL_CHUNK_MONTHS=1
DATA_BACKFILL_MAX_INSTRUMENTS=100
DATA_QUALITY_MAX_GAP_MINUTES=5
DATA_QUALITY_VOLUME_TOLERANCE_PCT=0.02
DATA_QUALITY_STALE_HOURS=24
DATA_STATUS_STALE_SESSIONS=1
DATA_VALIDATION_DAILY_ORACLE=true
DATA_RETENTION_RAW_DAYS=365
WORKER_SCHEDULES_ENABLED=true
INSTRUMENT_SYNC_LIMIT=20000

# Risk defaults
RISK_EQUITY=100000
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=1

API_URL=http://localhost:8000/api/v1

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

CONFIG_ENCRYPTION_KEY=

# Seed
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=replace-with-a-strong-password
SEED_OPERATOR_NAME="R2 Operator"
SEED_ACCOUNT_CODE=upstox-primary
SEED_ACCOUNT_NAME="Upstox Primary"
SEED_BROKER_USER_REF=
SEED_FORCE_PASSWORD_RESET=false
