{
  "name": "ai-trading-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "nx run-many -t build --exclude=web,api,worker,tests && nx run-many -t dev -p web,api,worker --parallel=3",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint && node scripts/check-boundaries.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test": "nx run-many -t test",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint && node scripts/check-boundaries.mjs",
    "graph": "nx graph",
    "db:generate": "pnpm --filter @ai-trading/database db:generate",
    "db:migrate": "pnpm --filter @ai-trading/database db:migrate",
    "db:seed": "pnpm --filter @ai-trading/database db:seed",
    "db:verify": "pnpm --filter @ai-trading/database db:verify",
    "db:push": "pnpm --filter @ai-trading/database db:push",
    "db:studio": "pnpm --filter @ai-trading/database db:studio",
    "docker:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f",
    "ports": "bash scripts/ports.sh",
    "dev:stop": "bash scripts/stop-dev.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:apps:up": "docker compose --env-file .env -f infra/docker/docker-compose.apps.yml up -d --build",
    "docker:apps:down": "docker compose --env-file .env -f infra/docker/docker-compose.apps.yml down"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.0",
    "nx": "22.7.12",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tsup": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
