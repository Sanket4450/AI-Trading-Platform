{
  "name": "worker",
  "root": "apps/worker",
  "sourceRoot": "apps/worker/src",
  "projectType": "application",
  "tags": ["type:app", "scope:worker"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/worker dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "pnpm --filter @ai-trading/worker build" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/worker start" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/worker lint" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/worker typecheck" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/worker test" }
    }
  }
}
