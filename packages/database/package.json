{
  "name": "@ai-trading/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup index.ts --format esm,cjs --dts --watch --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ai-trading/domain": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1"
  }
}
