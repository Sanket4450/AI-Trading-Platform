{
  "name": "@ai-trading/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup index.ts --format esm,cjs --dts --watch --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx migrate.ts",
    "db:seed": "pnpm --filter @ai-trading/domain build && tsx seed.ts",
    "db:verify": "tsx verify.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "tsup": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ai-trading/domain": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1"
  }
}
