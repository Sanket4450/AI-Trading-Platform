{
  "name": "@ai-trading/backtesting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup index.ts --format esm,cjs --dts --watch --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ai-trading/domain": "workspace:*",
    "@ai-trading/execution-engine": "workspace:*",
    "@ai-trading/risk-engine": "workspace:*",
    "@ai-trading/trading-engine": "workspace:*"
  }
}
