{
  "name": "market-data",
  "root": "packages/market-data",
  "sourceRoot": "packages/market-data",
  "projectType": "library",
  "tags": ["type:lib", "scope:market-data"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "pnpm --filter @ai-trading/market-data build" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/market-data dev" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/market-data typecheck" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/market-data lint" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/market-data test" }
    }
  }
}
