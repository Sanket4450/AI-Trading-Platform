{
  "name": "execution-engine",
  "root": "packages/execution-engine",
  "sourceRoot": "packages/execution-engine",
  "projectType": "library",
  "tags": ["type:lib", "scope:execution-engine"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "pnpm --filter @ai-trading/execution-engine build" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/execution-engine dev" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/execution-engine typecheck" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/execution-engine lint" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @ai-trading/execution-engine test" }
    }
  }
}
