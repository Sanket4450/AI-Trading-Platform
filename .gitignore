# ---------------------------------------------------------------------------
# Repository-wide ignore policy
# Applies to every app, package, test and infra folder.
# Do not add .gitignore files under apps/ or packages/.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
.eslintcache
.turbo/
.cache/

# Next.js generated type declarations
next-env.d.ts

# Nx cache and workspace metadata
.nx/

# Test output
test-results/
playwright-report/
blob-report/
.playwright/

# Environment and secrets
.env*
!.env.example
*.pem

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Deployment
.vercel/

# OS and editor files
.DS_Store
.vscode/
.idea/
*.local
tmp/

# Agent worktrees and machine-local agent state
.claude/worktrees
.claude/settings.local.json
