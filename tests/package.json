{
  "name": "@ai-trading/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:integration": "pnpm --filter @ai-trading/domain build && vitest run integration --passWithNoTests",
    "test:broker-contracts": "vitest run broker-contracts --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware ."
  },
  "dependencies": {
    "@ai-trading/adapters": "workspace:*",
    "@ai-trading/backtesting": "workspace:*",
    "@ai-trading/configuration": "workspace:*",
    "@ai-trading/database": "workspace:*",
    "@ai-trading/domain": "workspace:*",
    "@ai-trading/execution-engine": "workspace:*",
    "@ai-trading/market-data": "workspace:*",
    "@ai-trading/notifications": "workspace:*",
    "@ai-trading/observability": "workspace:*",
    "@ai-trading/risk-engine": "workspace:*",
    "@ai-trading/strategies": "workspace:*",
    "@ai-trading/trading-engine": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "vitest": "catalog:"
  }
}
